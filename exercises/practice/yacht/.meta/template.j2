{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.{{ case.property }}({{ case.input.dice | quote }}, solution_script.{{ case.input.category | upper | replace(" ", "_") }})
	var want = {{ case.expected | quote }}
	return [got, want, "{{ case.property }}({{ case.input.dice | quote }}, {{ case.input.category | upper | replace(" ", "_") }}) = %s, expected %s" % [got, want]]

{% endfor %}

