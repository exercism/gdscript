func _sorted(array):
	# Array.sort() sorts an array in place and returns null.
	# This helper method allows us to sort and compare in the same line.
	array.sort()
	return array

{% for case in cases %}
{%- if case.property == "allergicTo" %}

func test_{{ case.input.item }}_{{ case.func_name }}(allergies):
	allergies.score = {{ case.input.score }}
	var got = allergies.allergic_to("{{ case.input.item }}")
	var want = {{ case.expected | quote }}
	return [got, want, "with score={{ case.input.score }}, allergic_to() == %s, but want %s" % [got, want]]
{%- else %}

func test_list_when_{{ case.func_name }}(allergies):
	allergies.score = {{ case.input.score }}
	var got =_sorted(allergies.lst)
	var want = _sorted({{ case.expected }})
	return [
		got,
		want,
		"with score={{ case.input.score }}, lst\n  got: %s\n  want %s" % [got, want]
	]
{%- endif %}
{% endfor %}
