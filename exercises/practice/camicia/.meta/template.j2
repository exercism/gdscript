{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var want = {{ case.expected | quote }}
	var player_one = {{ case.input.playerA | quote }}
	var player_two = {{ case.input.playerB | quote }}
	var got = solution_script.{{ case.property | camel_to_snake }}(player_one, player_two)
	return [got, want, "{{ case.property | camel_to_snake }}(%s, %s) = %s, expected %s" % [player_one, player_two, got, want]]

{% endfor %}
