{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var colors = {{ case.input.colors | quote }}
	var want = {{ case.expected }}
	var got = solution_script.{{ case.property | camel_to_snake }}(colors)
	return [got, want, "{{ case.property | camel_to_snake }}(%s) = %s, expected %s" % [colors, got, want]]

{% endfor %}
