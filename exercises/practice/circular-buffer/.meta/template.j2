{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var res = null
	var buffer = solution_script.CircularBuffer.new({{ case.input.capacity }})
{% for op in case.input.operations %}
{%- if op.operation == "write" and op.should_succeed %}
	if not buffer.write({{ op.item }}):
		return [false, "write failed; expected success"]
{%- elif op.operation == "write" %}
	if buffer.write({{ op.item }}):
		return [false, "write succeeded; expected a failure"]
{%- elif op.operation == "read" and op.should_succeed %}
	res = buffer.read()
	if res != {{ op.expected }}:
		return [false, "read() = %s, expected %s" % [res, {{ op.expected }}]]
{%- elif op.operation == "read" %}
	res = buffer.read()
	if res != null:
		return [false, "read() = %s, expected null" % res]
{%- elif op.operation == "overwrite" %}
	buffer.overwrite({{ op.item }})
{%- else %}
	buffer.{{ op.operation }}()
{%- endif %}
{% endfor %}
	return [true, true]

{% endfor %}
