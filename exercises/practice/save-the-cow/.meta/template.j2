{% for case in cases %}
{%- if not case.expect_error %}{% for prop, val in case.expected.items() %}
func test_{{ case.func_name }}__{{ prop | camel_to_snake }}(solution_script):
	var game = solution_script.SaveTheCow.new({{ case.input.word | quote }})
	for letter in {{ case.input.guesses | quote }}:
		game.guess(letter)
		if game.error != null:
			return [game.error, null]
	return [game.{{ prop | camel_to_snake }}, {{ val | quote }}]

{% endfor %}
{%- else %}
func test_{{ case.func_name }}__error(solution_script):
	var game = solution_script.SaveTheCow.new({{ case.input.word | quote }})
	for letter in {{ case.input.guesses[:-1] | quote }}:
		game.guess(letter)
		if game.error != null:
			return [game.error, null]
	game.guess({{ case.input.guesses[-1] | quote }})
	return [game.error, {{ case.expect_error_msg | quote }}]

{% endif %}
{%- endfor %}
