{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var subject = {{ case.input.subject | quote }}
	var candidates = {{ case.input.candidates | quote }}
	var want = {{ case.expected }}
	var got = solution_script.find_anagram(subject, candidates)
	return [got, want, 'find_anagram({{ case.input.subject | quote }}, {{ case.input.candidates | quote }} = %s, but want %s' % [got, want]]

{% endfor %}
