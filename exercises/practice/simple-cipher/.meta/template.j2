func test_{{ case.func_name }}(solution_script):
	var got = solution_script.Cipher.new({{ case.input.key | quote }}).{{ case.property | camel_to_snake }}({{ (case.input.plaintext or case.input.ciphertext) | quote }})
	var want = {{ case.expected | quote }}
	return [got, want]

