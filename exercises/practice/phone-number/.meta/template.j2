{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
{%- if not case.expect_error %}
	var want = {{ case.expected | quote }}
{%- else %}
	var want = null
{%- endif %}
	var got = solution_script.{{ case.property }}({{ case.given | quote }})
	return [got, want, "{{ case.property }}(%s) = %s, expected %s" % [{{ case.given | quote }}, got, want]]

{% endfor %}

