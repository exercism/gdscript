{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var initial = [{% for row in case.given %}
		{{ row | quote }},{% endfor %}
	]
	var want = [{% for row in case.expected %}
		{{ row | quote }},{% endfor %}
	]
	var got = solution_script.{{ case.property | camel_to_snake }}(initial)
	return [got, want, "{{ case.property | camel_to_snake }}(%s) = %s, expected %s" % [initial, got, want]]

{% endfor %}

