func _round(value):
	return snappedf(value, 0.01)


{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.on_planet({{ case.input.planet | quote }}, {{ case.input.seconds }})
{%- if not case.expect_error %}
	var want = {{ case.expected }}
	return [_round(got), _round(want), "on_planet(%s, %s) = %s, expected around %s" % [{{ case.input.planet | quote }}, {{ case.input.seconds }}, got, _round(want)]]
{%- else %}
	var want = null
	return [got, want, "on_planet(%s, %s) = %s, expected %s" % [{{ case.input.planet | quote }}, {{ case.input.seconds }}, got, want]]
{%- endif %}

{% endfor %}

