func _round(value):
	return snappedf(value, 0.01)


{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.on_planet({{ case.input.planet | togdscript }}, {{ case.input.seconds }})
{%- if not case.expect_error %}
	var want = {{ case.expected }}
	return [_round(got), _round(want)]
{%- else %}
	var want = null
	return [got, want]
{%- endif %}

{% endfor %}

