{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
{%- if case.property == "colorCode" %}
	var want = {{ case.expected }}
	var got = solution_script.{{ case.property | camel_to_snake }}({{ case.input.color | quote }})
	return [got, want, "{{ case.property | camel_to_snake }}(%s) = %s, expected %s" % [{{ case.input.color | quote }}, got, want]

{%- elif case.property == "colors" %}
	var colors = {{ case.expected | quote }}
	var got = solution_script.{{ case.property }}()
	return [got, colors, "{{ case.property }}() = %s, expected %s" % [got, want]]
{%- endif %}
{% endfor %}
