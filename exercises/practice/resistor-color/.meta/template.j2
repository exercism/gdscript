{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
{%- if case.property == "colorCode" %}
	return [solution_script.{{ case.property | camel_to_snake }}({{ case.input.color | togdscript }}), {{ case.expected }}]

{%- endif %}
{%- if case.property == "colors" %}
	var colors = [
		"black",
		"brown",
		"red",
		"orange",
		"yellow",
		"green",
		"blue",
		"violet",
		"grey",
		"white"
	]
	return [solution_script.{{ case.property }}(), colors]
{%- endif %}
{% endfor %}
