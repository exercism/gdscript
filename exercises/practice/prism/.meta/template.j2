{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var position = Vector2({{ case.input.start.x }}, {{ case.input.start.y }})
	var angle = {{ case.input.start.angle }}
	var prisms =  [{% for prism in case.input.prisms %}
		[{{ prism.id }}, Vector2({{ prism.x }}, {{ prism.y }}), {{ prism.angle }}],{% endfor %}
	]

	var want = {{ case.expected.sequence | togdscript }}
	var got = solution_script.{{ case.property | camel_to_snake }}(position, angle, prisms)
	return [got, want]

{% endfor %}

