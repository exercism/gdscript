{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.{{ case.property | camel_to_snake }}({{ case.given | quote }})
	var want = {{ case.expected | quote }}
	return [got, want, 'abbreviate({{ case.given | quote | replace("'", "\\'") }}) = %s, want {{ case.expected | quote }}' % got]

{% endfor %}

