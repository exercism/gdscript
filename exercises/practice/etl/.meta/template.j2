{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var inputs = { {%- for key, val in case.given.items() %}
		{{ key }}: {{ val | togdscript }},{% endfor %}
	}
	var expected = { {%- for key, val in case.expected.items() %}
		{{ key | togdscript }}: {{ val | togdscript }},{% endfor %}
	}
	return [solution_script.{{ case.property | camel_to_snake }}(inputs), expected]

{% endfor %}
