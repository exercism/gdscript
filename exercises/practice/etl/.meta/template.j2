{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var inputs = { {%- for key, val in case.given.items() %}
		{{ key }}: {{ val | quote }},{% endfor %}
	}
	var want = { {%- for key, val in case.expected.items() %}
		{{ key | quote }}: {{ val | quote }},{% endfor %}
	}
	var got = solution_script.{{ case.property | camel_to_snake }}(inputs)
	return [got, want, "{{ case.property | camel_to_snake }}(%s) = %s, expected %s" % [inputs, got, want]]

{% endfor %}
