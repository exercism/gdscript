{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var linked_list = solution_script.LinkedList.new({{ case.input.initialValues | togdscript }})
	var res = 0
{% for op in case.input.operations %}
{%- if op.operation == "count" %}
	res = linked_list.count()
	if res != {{ op.expected }}:
		return [false, "count() = %d; expected %d" % [res, {{ op.expected }}]]
{%- elif op.operation == "pop" and op.expected is sequence %}
	res = linked_list.pop()
	if res != null:
		return [false, "pop() = %d; expected null" % res]
{%- elif op.operation == "pop" %}
	res = linked_list.pop()
	if res != {{ op.expected }}:
		return [false, "pop() = %d; expected %d" % [res, {{ op.expected }}]]
{%- elif op.operation == "push" %}
	linked_list.push({{ op.value }})
{%- elif op.operation == "peek" and op.expected is sequence %}
	res = linked_list.peek()
	if res != null:
		return [false, "peek() = %d, expected null" % res]
{%- elif op.operation == "peek" %}
	res = linked_list.peek()
	if res != {{ op.expected }}:
		return [false, "peek() = %d; expected %d" % [res, {{ op.expected }}]]
{%- elif op.operation == "toList" %}
	res = linked_list.to_list()
	if res != {{ op.expected | togdscript }}:
		return [false, "to_list() = %s; expected %s" % [res, {{ op.expected | togdscript }}]]
{%- else %}
	linked_list.{{ op.operation }}()
{%- endif %}
{% endfor %}
	return [true, true]

{% endfor %}
