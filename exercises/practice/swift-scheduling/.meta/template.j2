{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.{{ case.property | camel_to_snake }}({{ case.input.meetingStart | togdscript }}, {{ case.input.description | togdscript }})
	var want = {{ case.expected | togdscript }}
	return [got, want]

{% endfor %}

