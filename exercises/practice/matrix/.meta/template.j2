{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var matrix = solution_script.Matrix.new({{ case.input.string | quote }})
	var got = matrix.{{ case.property }}({{ case.input.index | quote }})
	var want = {{ case.expected | quote }}
	return [got, want, "{{ case.property }}(%d) = %s, expected %s" % [{{ case.input.index | quote }}, got, want]]

{% endfor %}

