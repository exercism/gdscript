{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.{{ case.property | camel_to_snake }}({{ case.given.sum }}, {{ case.given.size }}, {{ case.given.exclude | togdscript }})
	var want = {{ case.expected | togdscript }}
	got.sort()
	want.sort()
	return [got, want]

{% endfor %}

