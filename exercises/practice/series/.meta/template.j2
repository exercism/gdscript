{% for case in cases %}
func test_{{ case.property }}_{{ case.func_name }}(solution_script):
{%- if not case.expect_error %}
	var want = {{ case.expected }}
{%- else %}
	var want = null
{%- endif %}
	var got = solution_script.{{ case.property }}({{ case.input.series | quote }}, {{ case.input.sliceLength }})
	return [got, want, "{{ case.property }}(%s, %d) = %s, expected %s" % [{{ case.input.series | quote }}, {{ case.input.sliceLength }}, got, want]]

{% endfor %}
