{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var got = solution_script.{{ case.property }}([{% for line in case.given %}
		{{ line | quote }},{% endfor %}
	])
{%- if not case.expect_error %}
	var want = {{ case.expected | quote }}
{%- else %}
	var want = null
{%- endif %}
	return [got, want]

{% endfor %}

