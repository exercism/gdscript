{% for case in cases %}
func test_{{ case.func_name }}(solution_script):
	var want = {{ case.expected | quote }}
	var list_one = {{ case.input.listOne | quote }}
	var list_two = {{ case.input.listTwo | quote }}
	var got = solution_script.{{ case.property }}(list_one, list_two)
	return [got, want, "{{ case.property }}(%s, %s) = %s, expected %s" % [list_one, list_two, got, want]]

{% endfor %}

